# === Base de données (Neon) ===
# Connexion pooled : application et seed (pilote WebSocket)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"
# Connexion directe : CLI Prisma (migrations), lue par prisma.config.ts
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<database>?sslmode=require"

# === Connexion par le portail admission (contrat portail v1 §3.9) ===
# Émetteur : le même partout, poste compris, sans barre finale
PORTAIL_ISSUER="https://portail-admission.vercel.app/api/auth"
# Client de l'environnement (dev sur le poste), donné par le super-admin du portail ; secret affiché une seule fois
PORTAIL_CLIENT_ID="<identifiant du client>"
PORTAIL_CLIENT_SECRET="<secret du client>"

# === NextAuth ===
# Port fixe du poste (D12) : l'adresse de retour déclarée au portail est exacte, port compris
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="une-chaine-aleatoire-de-32-caracteres-minimum"

# === APIs Cartographiques ===
# BAN : pas de clé nécessaire
BAN_API_URL="https://api-adresse.data.gouv.fr"
# OpenRouteService : clé gratuite à obtenir sur openrouteservice.org
ORS_API_URL="https://api.openrouteservice.org"
ORS_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === Mail ===
MAIL_SENDER_ADDRESS="flotte@entreprise.fr"
